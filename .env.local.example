# Copy to .env.local and fill in the values from your Supabase project
# (Project Settings → API, the publishable key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Reminders (phone notifications)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Random string, at least 16 characters (Vercel sends it to the cron job)
CRON_SECRET=
# Supabase secret key (server only)
SUPABASE_SECRET_KEY=
